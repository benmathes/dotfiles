{
    "model": "sonnet[1m]",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/allow-bash-syntax.sh"
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/bell.sh"
                    }
                ]
            }
        ]
    },
    "effortLevel": "high",
    "preferredNotifChannel": "terminal_bell"
}
